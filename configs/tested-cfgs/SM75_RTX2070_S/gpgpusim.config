# This config models the Turing RTX 2070 Super
# Seeded from SM75_RTX2060_S with HW-calibration tuning for 2070S (40 SMs,
# base clock 1605 MHz). Where divergence from the Accel-Sim SM75_RTX2060_S
# baseline exists, the change source is noted inline as:
#   [SPEC] — from NVIDIA Turing whitepaper / product spec
#   [MICRO25] — adopted from MICRO 2025 Huerta et al.'s SM75_RTX2070_S config
#   [TODO] — placeholder value, needs microbench calibration
# See also: accel-hopper-paper/discussions/2026-04-16_phase3_tier2_roadmap.md
# for the MICRO 2025 simulator-specific params we have NOT enabled yet.

# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 75

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
# [TODO] Single-kernel MAPE comparisons use HW `gpc__cycles_elapsed.max`
# which starts counting at first SM work, so launch_latency shifts sim
# estimates without a matching HW component. Keep at 0 for clean MAPE;
# raise to ~1500 (MICRO 2025) / measured ~6000 (microbench/launch_latency
# on 2070S @1605 MHz median) only for end-to-end wall-clock comparisons
# that include host-side dispatch overhead.
-gpgpu_kernel_launch_latency 0
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 7
-gpgpu_compute_capability_minor 5

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
# [SPEC] RTX 2070 Super has 40 SMs
-gpgpu_n_clusters 40
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 16
-gpgpu_n_sub_partition_per_mchannel 2
-gpgpu_clock_gated_lanes 1

# clock domains: <Core>:<Interconnect>:<L2>:<DRAM>
# [SPEC] 2070 Super base 1605 MHz, boost 1770 MHz. Use base clock by default.
# GDDR6 at 14 Gbps -> 3500 MHz DRAM command clock.
-gpgpu_clock_domains 1605.0:1605.0:1605.0:3500.0
# boost mode
# -gpgpu_clock_domains 1770.0:1770.0:1770.0:3500.0

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 75

# This implies a maximum of 32 warps/SM
-gpgpu_shader_core_pipeline 1024:32
-gpgpu_shader_cta 32
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE
# Turing has 4 SP SIMD units, 4 INT units, 4 SFU units, 8 Tensor core units.
# [MICRO25] Enable all 4 DP slots (vanilla 2060_S has 0 in DP positions).
# Rationale: Turing DP path reuses FP32 units via SFU throttling; leaving DP
# slots at 0 caused mis-simulated fallbacks in MICRO 2025's validation.
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4

# Instruction latencies and initiation intervals
# "ADD,MAX,MUL,MAD,DIV"
# All Div operations are executed on SFU unit
-ptx_opcode_latency_int 4,13,4,5,145,32
-ptx_opcode_initiation_int 2,2,2,2,8,4
-ptx_opcode_latency_fp 4,13,4,5,39
-ptx_opcode_initiation_fp 2,2,2,2,4
-ptx_opcode_latency_dp 8,19,8,8,330
-ptx_opcode_initiation_dp 4,4,4,4,130
-ptx_opcode_latency_sfu 100
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 64
-ptx_opcode_initiation_tensor 64

# Turing has four schedulers per core
-gpgpu_num_sched_per_core 4
# [MICRO25 + SPEC] Turing uses Greedy-then-Oldest. Vanilla 2060_S had lrr
# which mis-models Turing's documented scheduling.
-gpgpu_scheduler gto
## In Turing, a warp scheduler can issue 1 inst per cycle
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

# shared memory bankconflict detection
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 75

# Turing has sub core model, in which each scheduler has its own register file and EUs
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8
# [MICRO25 + SPEC] Turing RF has 8 banks physically. Vanilla 2060_S used 16
# to compensate for absent RFC modeling; once Phase 3 Step 3e (RFC) lands
# we will want the 8-bank model. Keep 8 now and accept some contention
# inaccuracy in exchange for architectural faithfulness.
-gpgpu_num_reg_banks 8
-gpgpu_reg_file_port_throughput 2

# L1 / shared memory configuration
# <sector?>:<nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>,<data_port_width>
# [SPEC] Turing adaptive L1/shmem pool: 96 KB unified, shmem carveout 0/8/16/32/64.
# https://docs.nvidia.com/cuda/cuda-c-programming-guide/#shared-memory-7-x
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64
-gpgpu_unified_l1d_size 96
-gpgpu_l1_banks 4
# [MICRO25] 3 sets * 128 B * 256 assoc = 96 KB, 384 MSHR, 48 merge, 32 B port.
# Sectored L1 with T(ransparent) write-through, L(azy) write-allocate.
-gpgpu_cache:dl1 S:3:128:256,L:T:m:L:L,A:384:48,32:0,32
-gpgpu_l1_banks_hashing_function 0
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_flush_l2_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 0
# [TODO] 2060_S has -gpgpu_l1_latency 20 / -gpgpu_smem_latency 20 literals.
# MICRO 2025 replaces these with -memory_l1d_minimum_latency 13 etc in the
# Tier 2 block. Keep 20 here as conservative default until we port Tier 2.
-gpgpu_l1_latency 20
-gpgpu_smem_latency 20

# shared memory
-gpgpu_shmem_size 65536
-gpgpu_shmem_sizeDefault 65536
-gpgpu_shmem_per_block 65536

# L2 cache
# 64 sets * 128 B * 16 assoc per sub-partition = 128 KB/sub, 16 sub-part -> 4 MB L2.
# [MICRO25] 192 MSHR, 96 merge (vanilla 2060_S had A:192:4 — merge too small).
-gpgpu_cache:dl2 S:64:128:16,L:B:m:L:P,A:192:96,32:0,32
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 1
# [MICRO25] partition_indexing 2 = IPOLY hashing, better entropy than vanilla 0.
-gpgpu_memory_partition_indexing 2

# [MICRO25] 128 KB Inst cache, 32 MSHR / 32 merge / 32 B port.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:32:32,32
-gpgpu_inst_fetch_throughput 4
# TEX is deprecated in Volta; kept for legacy
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# [MICRO25] 64 KB Const, realistic cache (vanilla 2060_S uses perfect).
-gpgpu_const_cache:l1 N:4:64:8,L:R:f:N:L,S:32:32,32
-gpgpu_perfect_inst_const_cache 0

# interconnection
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
-icnt_arbiter_algo 1
-icnt_flit_size 40

# memory partition latency config
# [MICRO25] Higher latencies reflect 2070S GDDR6@14Gbps + PCIe vs 2060S profile.
-gpgpu_l2_rop_latency 186
-dram_latency 196

# dram model config
-gpgpu_dram_scheduler 1
# [MICRO25] Queue sizes tuned for wider 2070S memory subsystem.
-gpgpu_frfcfs_dram_sched_queue_size 160
-gpgpu_dram_return_queue_size 160

# Turing has GDDR6
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 2
-gpgpu_dram_burst_length 16
-dram_data_command_freq_ratio 4
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS

# Use the same GDDR5 timing, scaled to 3500MHZ
-gpgpu_dram_timing_opt "nbk=16:CCD=4:RRD=10:RCD=20:RAS=50:RP=20:RC=62:
                        CL=20:WL=8:CDLR=9:WR=20:nbkgrp=4:CCDL=4:RTPL=4"

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

# stat collection
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# tracing functionality
#-trace_enabled 1
#-trace_components WARP_SCHEDULER,SCOREBOARD
#-trace_sampling_core 0

# ============================================================================
# Phase 3 Step 3f.B.2 — per-subcore L0 instruction cache (no prefetcher yet).
# Geometry mirrors MICRO 2025's SM75_RTX2070_S config.
# MSHR is "A" (ASSOC) since this is a non-sectored cache. MICRO 2025 uses
# "S" (SECTOR_ASSOC), but their fill chain through l0_icnt fragments
# requests so original_mf is set; our shorter chain calls L0->fill
# directly on L1I HIT, which would fail SECTOR_ASSOC's original_mf assert.
-is_L0I_enabled 1
-gpgpu_cache:il0 N:4:128:32,L:R:f:N:L,A:32:16,8
-latency_L0_to_L1 39
-latency_L1_to_L0 39
# Phase 3 Step 3f.B.3 — sequential stream buffer prefetcher per L0.
-is_instruction_prefetching_enabled 1
# MICRO 2025 default = 8. We tune lower (2) because their A6000
# baseline differs in L1I bandwidth and HW prefetcher behavior;
# 8 over-prefetches small kernels (vec_add, reduce_sum) on 2070S.
# Phase 4 final tune may revisit this.
-prefetch_per_stream_buffer_size 1
-num_instruction_prefetches_per_cycle 1
# is_instruction_prefetching_enabled stays 0 until Step 3f.B.3 lands.
# ============================================================================
# Tier 2 roadmap (NOT enabled here; see discussions/2026-04-16_phase3_tier2_roadmap.md)
# ----------------------------------------------------------------------------
# The following MICRO 2025 params require new simulator features we have not
# yet implemented. Do NOT enable them until the corresponding Phase 3 step:
#
#   -is_L0I_enabled / -gpgpu_cache:il0 / -latency_L0_to_L1
#       -> Phase 3 Step 3f  (L0 I-cache + stream buffer prefetcher)
#   -is_rf_cache_enabled / -max_operands_regular_register_file
#       -> Phase 3 Step 3e  (Register File Cache)
#   -is_SM_remodeling_enabled / -num_subcores_in_SM
#       -> Phase 3 Step 3g  (SM + Subcore class split, out of current scope)
#   -is_ibuffer_remodeled_enabled / -ibuffer_remodeled_size
#       -> paired with 3g
#   -scoreboard_war_mode opc
#       -> Phase 3 Step 3d  (fixed-latency vs variable-latency split)
#   -number_of_coalescers / -prt_selection_policy_string
#       -> Phase 3 Step 3h  (per-subcore memory queue)
# ============================================================================
